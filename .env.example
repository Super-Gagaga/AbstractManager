# 复制本文件为 .env 并填入真实配置：cp .env.example .env
# .env 包含敏感信息，已被 .gitignore 排除，请勿提交到仓库

# --- DB 配置 ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=your_database

# 连接池配置（可选）
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=10

# --- Redis 配置 ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 没有密码时可留空或保持注释
# REDIS_PASSWORD=

# --- 服务配置 ---
PORT=8080

# --- Cache Aside 配置 ---
# 数据从 DB 加载并写入缓存后的 TTL（秒）
CACHE_ASIDE_TTL=3600
# 缓存命中时是否刷新 TTL
# true: 每次读取都延长缓存存活时间
# false: 保持原始 TTL
CACHE_HIT_REFRESH=false

# --- 超时配置（可选，均有内置默认值） ---
# DB 操作默认超时，默认 30 秒
# DB_TIMEOUT_SECONDS=30
# Redis 操作默认超时，默认 10 秒
# REDIS_TIMEOUT_SECONDS=10
# DDL 操作默认超时（DDL 通常较慢），默认 60 秒
# DDL_TIMEOUT_SECONDS=60

# --- 日志配置（可选） ---
# 日志级别 debug / info / warn / error，默认 info
# LOG_LEVEL=info
# 日志格式 text / json（生产建议 json），默认 text
# LOG_FORMAT=text
# SQL 慢查询阈值（毫秒），超过记为 Warn，默认 500
# DB_SLOW_QUERY_MS=500
